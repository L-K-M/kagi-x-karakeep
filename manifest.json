{
  "manifest_version": 3,
  "name": "Kagi × Karakeep",
  "version": "1.0.0",
  "description": "Shows Karakeep bookmark results beside Kagi search results.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://kagi.com/search*",
    "https://cloud.karakeep.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http: https:"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kagi.com/search*"
      ],
      "js": [
        "src/content/kagi-results.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kagi × Karakeep",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kagi-x-karakeep@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
